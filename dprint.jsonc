{
  "json": {
    "trailingCommas": "never",
    "associations": ["**/*.{jsonc,json}"]
  },
  "markdown": {
  },
  "yaml": {
    "quotes": "preferSingle",
    "trimTrailingWhitespaces": false
  },
  "toml": {
  },
  // Revisit once dprint supports fully gitignore: https://github.com/dprint/dprint/issues/1012
  "excludes": [
    ".git",
    ".direnv",
    "dist",
    "result",
    "tmp",
    "**/*.lock.yaml",
    "**/*-lock.yaml",
    "**/*lock.json",
    // Agent configuration — managed by APM or upstream sources.
    // Excluded pre-emptively so the template works cleanly when additional
    // targets (codex, opencode, and so on) are enabled in apm.yml.
    ".claude/**",
    ".agents/**",
    ".apm/**",
    ".opencode/**",
    ".codex/**",
    ".github/skills/**",
    ".github/instructions/**",
    ".github/prompts/**",
    "openspec/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.21.3.wasm",
    "https://plugins.dprint.dev/markdown-0.21.1.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
  ]
}
